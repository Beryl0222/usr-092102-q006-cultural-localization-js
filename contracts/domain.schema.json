{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "文化出海本地化合议领域事件",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "enum": [
        "BOUNDARY_REGISTERED",
        "ADAPTATION_PROPOSED",
        "RIGHTS_CLEARED",
        "CONTRIBUTION_ACCEPTED",
        "MARKET_RELEASED"
      ]
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "source_ip",
        "market_adaptation",
        "contributor_term",
        "release_clearance"
      ]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
